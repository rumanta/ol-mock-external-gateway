# Local server port. Use a port that does not clash with OpenLearning services.
PORT=5678

# OpenLearning QA signs the external gateway JWTs. The mock gateway uses this to check them.
OPENLEARNING_JWKS_URL=https://qa.openlearning.com/.well-known/jwks.json/

# Keep this true until you are ready to actually enrol the learner.
DRY_RUN=true

# Optional: override JWT audience validation. Leave blank to accept the portal path from the token.
# EXPECTED_AUDIENCE=

# OpenLearning enrolment settings. Use QA only for this mock gateway.
# Example shape: https://qa-api.openlearning.com/v2.2
OPENLEARNING_API_BASE_URL=

# Optional full URL overrides. Usually leave these blank and use OPENLEARNING_API_BASE_URL.
ASYNC_ENGINE_PROGRAM_ENROL_URL=
ASYNC_ENGINE_COURSE_ENROL_URL=

# Use a QA API key for an institution admin account that can enrol learners.
ASYNC_ENGINE_AUTH_HEADER_NAME=X-API-Key
ASYNC_ENGINE_AUTH_HEADER_VALUE=

# Optional: where to redirect when the token has no redirect_url.
DEFAULT_REDIRECT_URL=https://qa.openlearning.com/
