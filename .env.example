# Copy this file to .env, then fill in the values for your QA test.
#
# Do not commit .env. It will contain your QA API key.

# Required for local testing.
# Use a port that does not clash with OpenLearning services on your machine.
PORT=5678

# Required for checking that the payment details really came from OpenLearning QA.
# Usually leave this as-is for QA testing.
OPENLEARNING_JWKS_URL=https://qa.openlearning.com/.well-known/jwks.json/

# Required.
# true  = practice mode. The page works, but the learner is not enrolled.
# false = real QA test. The mock gateway calls OpenLearning QA to enrol the learner.
DRY_RUN=true

# Required when DRY_RUN=false.
# This is the OpenLearning QA API base URL used to build the enrolment API URL.
OPENLEARNING_API_BASE_URL=

# Required when DRY_RUN=false.
# Use a QA API key for an institution admin account that can enrol learners.
ASYNC_ENGINE_AUTH_HEADER_NAME=X-API-Key
ASYNC_ENGINE_AUTH_HEADER_VALUE=

# Optional.
# Where to redirect when the payment details have no redirect_url.
DEFAULT_REDIRECT_URL=https://qa.openlearning.com/

# Optional.
# Use only if you want to reject payment details for every portal except one specific portal.
# Example: EXPECTED_AUDIENCE=ubld
# EXPECTED_AUDIENCE=

# Optional full URL overrides.
# Usually leave these blank. The mock gateway builds the correct program and course URLs
# from OPENLEARNING_API_BASE_URL.
ASYNC_ENGINE_PROGRAM_ENROL_URL=
ASYNC_ENGINE_COURSE_ENROL_URL=
